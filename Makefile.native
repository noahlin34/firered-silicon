CC := clang
PREPROC := tools/preproc/preproc

# Including spritesheet_rules.mk below defines concrete targets; keep `all` as
# the default goal rather than the first rule from that file.
.DEFAULT_GOAL := all

# Top-left FPS overlay in the SDL2 window (src/platform/sdl2.c). Release builds:
#   rm -f build/native/platform/sdl2.o && make -f Makefile.native FPS_OVERLAY=0
# Objects do not depend on CFLAGS, so the stale sdl2.o must be removed first.
FPS_OVERLAY ?= 1

CFLAGS := -Wall -Wextra -std=c11 -O2 -DPORTABLE -DMODERN=1 -DFIRERED -DENGLISH -DREVISION=0 -Iinclude \
          $(shell /opt/homebrew/bin/sdl2-config --cflags) \
          -Wno-ignored-qualifiers -Wno-unused-parameter -Wno-unused-function -Wno-unused-variable \
          -Wno-sign-compare -Wno-unknown-escape-sequence \
          $(if $(filter 1,$(FPS_OVERLAY)),-DFPS_OVERLAY,)
LDFLAGS := $(shell /opt/homebrew/bin/sdl2-config --libs)

# Canonical overworld spritesheet rules. pret's spritesheet_rules.mk gives every
# object event sprite the -mwidth/-mheight flags its PNG layout needs; without
# them gbagfx emits plain row-major tiles, the engine's overworld_frame() macro
# addresses the wrong tiles, and the first frames come out blank (invisible NPCs).
GFX := tools/gbagfx/gbagfx
include spritesheet_rules.mk

OBJ_EVENT_PICS := $(patsubst %.png,%.4bpp,$(wildcard graphics/object_events/pics/*/*.png))

# Sprites with no entry in spritesheet_rules.mk (mostly single-frame misc/pokemon
# icons) really are row-major; pret relies on this plain rule for them.
%.4bpp: %.png
	@$(GFX) $< $@

PLATFORM_SRCS := src/platform/system.c \
                 src/platform/bios.c \
                 src/platform/ppu.c \
                 src/platform/sdl2.c \
                 src/platform/stubs.c \
                 src/platform/new_game_intro_text.c \
                 src/platform/battle_engine_stubs.c \
                 src/platform/overworld_stubs.c \
                 src/platform/dev_boot.c \
                 src/platform/main.c

ENGINE_SRCS := src/main.c \
               src/gpu_regs.c \
               src/palette.c \
               src/task.c \
               src/malloc.c \
               src/scanline_effect.c \
               src/dma3_manager.c \
               src/bg.c \
               src/random.c \
               src/string_util.c \
               src/pokeball.c \
               src/math_util.c \
               src/trig.c \
               src/decompress.c \
               src/blend_palette.c \
               src/blit.c \
               src/window.c \
               src/menu.c \
               src/menu2.c \
               src/text_printer.c \
               src/list_menu.c \
               src/menu_helpers.c \
               src/play_time.c \
               src/money.c \
               src/event_data.c \
               src/load_save.c \
               src/mail_data.c \
               src/pokemon_storage_system.c \
               src/pokemon_size_record.c \
               src/renewable_hidden_items.c \
               src/roamer.c \
               src/pokedex.c \
               src/item_use.c \
               src/overworld.c \
               src/fieldmap.c \
               src/field_camera.c \
               src/field_control_avatar.c \
               src/field_tasks.c \
               src/metatile_behavior.c \
               src/script.c \
               src/script_movement.c \
               src/event_object_lock.c \
               src/script_pokemon_util.c \
               src/field_weather_effects.c \
               src/field_fadetransition.c \
               src/bike.c \
               src/wild_encounter.c \
               src/field_message_box.c \
               src/coord_event_weather.c \
               src/trainer_pokemon_sprites.c \
               src/new_game.c \
               src/save_location.c \
               src/prof_pc.c

PREPROC_SRCS := src/title_screen.c \
                src/sprite.c \
                src/text.c \
                src/text_window.c \
                src/text_window_graphics.c \
                src/strings.c \
                src/main_menu.c \
                src/graphics.c \
                src/data.c \
                src/new_menu_helpers.c \
                src/oak_speech.c \
                src/naming_screen.c \
                src/pokemon.c \
                src/util.c \
                src/battle_main.c \
                src/pokemon_icon.c \
                src/keyboard_text.c \
                src/item.c \
                src/move_descriptions.c \
                src/field_player_avatar.c \
                src/event_object_movement.c \
                src/field_weather.c \
                src/fldeff_flash.c \
                src/tilesets.c \
                src/field_effect.c \
                src/field_door.c \
                src/maps.c \
                src/scrcmd.c \
                src/script_menu.c
OBJ_DIR := build/native
OBJS := $(patsubst src/%.c,$(OBJ_DIR)/%.o,$(PLATFORM_SRCS) $(ENGINE_SRCS) $(PREPROC_SRCS))

TARGET := firered-native

.PHONY: all clean run assets

all: assets $(TARGET)

assets: $(OBJ_EVENT_PICS)
	@mkdir -p $(OBJ_DIR)/platform
	@tools/gbagfx/gbagfx graphics/title_screen/border_bg.png graphics/title_screen/border_bg.4bpp
