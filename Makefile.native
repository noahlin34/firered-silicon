$(OBJ_DIR)/%.o: src/%.c | $(GEN_HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(DEPFLAGS) -MT $@ -c -o $@ $<

# Sources containing charmap text (`_("...")`) or INCBIN assets must be run
# through tools/preproc (fix #2). GNU Make 3.81 (macOS) rejects static pattern
# rules carrying a generated target list, so one rule per source is emitted via
# $(eval). Adding a file to PREPROC_SRCS is then all that is needed.
#
# `$$` is deliberate: the rule text passes through $(call) (one expansion) and
# then $(eval) (parses the result), so a single `$$` survives as `$` in the
# recipe where `$@`/`$<` must expand at build time.
define PREPROC_RULE
$(OBJ_DIR)/$(1).o: src/$(1).c | battle-scripts $(PREPROC) $(GFX) $(GEN_HEADERS)
	@mkdir -p $$(dir $$@)
	$$(CC) -E $$(DEPFLAGS) -MT $$@ -MF $$(@:.o=.d) $$(CFLAGS) $$< | $$(PREPROC) -i $$< charmap.txt | $$(CC) $$(CFLAGS) -x c -c -o $$@ -
endef

$(foreach src,$(PREPROC_SRCS),$(eval $(call PREPROC_RULE,$(patsubst src/%.c,%,$(src)))))


# Every object INCBINDs generated assets (graphics, tilesets) during
# preprocessing, so the assets must exist before the first object compiles.
# Without this, a clean tree races: the preprocessor opens a file the asset rule
# has not created yet. The dependency is the stamp, not the phony `assets`
# target — see the comment on ASSET_STAMP. Order-only, so it changes no rebuild
# semantics.
$(OBJS): | $(ASSET_STAMP)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) $^ $(LDFLAGS) -o $@

run: $(TARGET)
	./$(TARGET)

# --- Unit test binary -------------------------------------------------------
# `firered-tests` links the SAME engine objects as the game and substitutes a
# harness for the three SDL-facing translation units. Nothing in src/ is
# test-specific and nothing in src/ includes the harness: the engine already
# routes every frame through Platform_RenderAndPresent, and that symbol is the
# seam (see tests/platform_host.c). Excluding sdl2.o also removes the display
# clock, so the suite runs the engine flat out instead of at 59.7275 Hz.
#
# dev_panel.o is dropped too: it is a second SDL window with its own renderer,
# used only for manual testing, and is deliberately not covered.
TEST_SRCS := $(wildcard tests/*.c)
TEST_OBJS := $(patsubst tests/%.c,$(OBJ_DIR)/tests/%.o,$(TEST_SRCS))
TEST_EXCLUDED := $(OBJ_DIR)/platform/sdl2.o $(OBJ_DIR)/platform/dev_panel.o $(OBJ_DIR)/platform/main.o
TEST_ENGINE_OBJS := $(filter-out $(TEST_EXCLUDED),$(OBJS))

# _XOPEN_SOURCE must precede every system header, so it cannot be set from inside
# the harness headers -- it is a compile flag. ucontext.h (frame.c) needs it.
TEST_CFLAGS := $(CFLAGS) -D_XOPEN_SOURCE=700

# Named script opcodes for tests, generated from the engine's own dispatch table
# (src/data/script_cmd_table.h). Regenerated when that table changes -- the
# generator is the only thing that knows the numbering, and a shifted opcode
# silently invalidates every script assertion. Output is tracked in git, matching
# the maps_data.h / battle_data.h convention.
TEST_SCRIPT_OPS := tests/script_ops.h

$(TEST_SCRIPT_OPS): src/data/script_cmd_table.h tools/gen_script_ops.py
	@python3 tools/gen_script_ops.py

script-ops: $(TEST_SCRIPT_OPS)

TARGET_TESTS := firered-tests

# The test binary's prerequisites are computed IN THE RECIPE, not by make.
#
# make decides whether a target is out of date before it runs any recipe, so it
# cannot observe "a test file was deleted" -- that is not a change to any
# prerequisite it tracks. Two attempts to work around that with a stamp and with a
# self-remaking include both failed intermittently, which is worse than failing
# loudly: a deleted test sometimes stayed in the binary, and an added one
# sometimes did not appear, because the relink raced make's own staleness check
# (GNU Make 3.81 compares timestamps at one-second resolution).
#
# So this rule owns the decision: it prunes objects whose source is gone, and
# relinks when the object set changed or any object is newer than the binary. The
# recipe always runs; the work it does is skipped when nothing changed. Costing a
# few milliseconds to check is the right trade for never reporting a test that is
# not in the tree.
TEST_OBJ_LIST := $(OBJ_DIR)/tests/.linked-objects

.PHONY: FORCE
FORCE:

# The objects are built through this edge. They are ORDER-ONLY prerequisites of
# $(TARGET_TESTS), which matters under `-j`:
#
#   tests: $(TEST_OBJS) $(TARGET_TESTS)
#
# makes those two branches independent, so make schedules both at once. Since
# $(TARGET_TESTS) carries FORCE, its recipe runs immediately and links against
# $(TEST_OBJS) while they are still being compiled -- reproduced deterministically
# by `rm -rf build/native/tests && make tests -j8`, which dies with
# `clang: error: no such file or directory: 'build/native/tests/mom.o'`.
#
# Order-only rather than plain: it guarantees the objects exist before the link
# recipe runs without adding timestamp-based staleness on top of the recipe's own
# check (which is what FORCE already forces). The recipe still computes its link
# inputs itself, so a deleted test source is still noticed there and not by make.
tests: $(TEST_OBJS) $(TARGET_TESTS)

# Rebuild the engine objects from scratch, then the tests.
#
# Needed because GNU Make 3.81 (the system make on macOS, and there is no newer
# one unless Homebrew's gmake is installed) compares mtimes at ONE-SECOND
# granularity. So an object rebuilt in the same second as its source was last
# written is considered up to date even when the source is newer, which makes a
# source edit invisible. That is not hypothetical: a `cp` restore of a source
# file (mtime = the copy) onto an object built moments earlier reproduces it
# exactly, and `touch`ing the file does NOT fix it when the touch lands in the
# same second. Deleting the objects always does.
#
# Use this after mutating a source to prove a test fails and then restoring it.
clean-tests: 
	@for o in $(TEST_ENGINE_OBJS) $(TEST_OBJS); do rm -f "$$o" "$${o%.o}.d"; done
	@$(MAKE) -f $(firstword $(MAKEFILE_LIST)) tests

$(OBJ_DIR)/tests/%.o: tests/%.c $(TEST_SCRIPT_OPS) | $(ASSET_STAMP)
	@mkdir -p $(dir $@)
	$(CC) $(TEST_CFLAGS) $(DEPFLAGS) -MT $@ -c -o $@ $<

$(TARGET_TESTS): $(TEST_ENGINE_OBJS) FORCE | $(TEST_OBJS)
	@mkdir -p $(dir $(TEST_OBJ_LIST))
	@for o in $(OBJ_DIR)/tests/*.o; do \
	    [ -e "$$o" ] || continue; \
	    case " $(TEST_OBJS) " in \
	        *" $$o "*) ;; \
	        *) echo "[tests] removing stale $$o"; rm -f "$$o" "$${o%.o}.d";; \
	    esac; \
	done
	@printf '%s\n' $(TEST_OBJS) > $(TEST_OBJ_LIST).tmp
	@newest=$$(ls -t $(TEST_OBJS) $(TEST_ENGINE_OBJS) 2>/dev/null | head -1); \
	if [ ! -e $@ ] || [ -n "$$newest" ] && [ $@ -ot "$$newest" ] \
	   || ! cmp -s $(TEST_OBJ_LIST).tmp $(TEST_OBJ_LIST); then \
	    $(CC) $(TEST_CFLAGS) $(TEST_OBJS) $(TEST_ENGINE_OBJS) -o $@ || exit 1; \
	    mv $(TEST_OBJ_LIST).tmp $(TEST_OBJ_LIST); \
	else \
	    rm -f $(TEST_OBJ_LIST).tmp; \
	fi

test-list: $(TARGET_TESTS)
	@./$(TARGET_TESTS) --list

clean:
	rm -rf $(OBJ_DIR) $(TARGET) $(TARGET_TESTS)

# Header dependencies, one .d per object, written by DEPFLAGS above. Last, so
# every rule is already defined; -include (not include) because the files do not
# exist on a clean tree.
-include $(OBJS:.o=.d) $(TEST_OBJS:.o=.d)
