	@tools/gbagfx/gbagfx graphics/text_window/unused.png graphics/text_window/unused.4bpp
	@tools/gbagfx/gbagfx graphics/text_window/menu_message.png graphics/text_window/menu_message.4bpp
	@tools/gbagfx/gbagfx graphics/interface/std_menu.pal graphics/interface/std_menu.gbapal
	@tools/gbagfx/gbagfx graphics/script_menu/aerodactyl_fossil.png graphics/script_menu/aerodactyl_fossil.4bpp
	@tools/gbagfx/gbagfx graphics/script_menu/aerodactyl_fossil.png graphics/script_menu/aerodactyl_fossil.gbapal
	@tools/gbagfx/gbagfx graphics/script_menu/kabutops_fossil.png graphics/script_menu/kabutops_fossil.4bpp
