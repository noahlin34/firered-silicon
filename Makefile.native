CC := clang
PREPROC := tools/preproc/preproc

# Including spritesheet_rules.mk below defines concrete targets; keep `all` as
# the default goal rather than the first rule from that file.
.DEFAULT_GOAL := all

# Top-left FPS overlay in the SDL2 window (src/platform/sdl2.c). Release builds:
#   rm -f build/native/platform/sdl2.o && make -f Makefile.native FPS_OVERLAY=0
# Objects do not depend on CFLAGS, so the stale sdl2.o must be removed first.
FPS_OVERLAY ?= 1

CFLAGS := -Wall -Wextra -std=c11 -O2 -DPORTABLE -DMODERN=1 -DFIRERED -DENGLISH -DREVISION=0 -Iinclude -Isrc \
          $(shell /opt/homebrew/bin/sdl2-config --cflags) \
          -Wno-ignored-qualifiers -Wno-unused-parameter -Wno-unused-function -Wno-unused-variable \
          -Wno-sign-compare -Wno-unknown-escape-sequence \
          $(if $(filter 1,$(FPS_OVERLAY)),-DFPS_OVERLAY,)
LDFLAGS := $(shell /opt/homebrew/bin/sdl2-config --libs)

# Header dependency tracking. Without it a header edit is invisible to make --
# `touch src/data/maps_data.h` plans nothing -- because object files depend on
# their .c only. That is how a `git pull` that changed the tracked generated
# header src/data/maps_data.h produced a link with undefined script/text
# symbols: src/maps.c (the only file including it) was unchanged, so maps.o kept
# exporting the old symbol set while main.o, which did change, referenced the
# new one. -MMD -MP writes a .d per object that is -include'd at the bottom of
# this file; -MP adds phony targets for headers so a deleted one is not a hard
# error. Each rule passes -MT $@ as well: clang otherwise names the target after
# the output argument it saw, and in the preproc pipeline that is not the object
# path, so the generated rule would attach to a target make never builds. Keep
# these out of CFLAGS -- CFLAGS also builds the link command, where they are
# meaningless.
DEPFLAGS := -MMD -MP

# Canonical overworld spritesheet rules. pret's spritesheet_rules.mk gives every
# object event sprite the -mwidth/-mheight flags its PNG layout needs; without
# them gbagfx emits plain row-major tiles, the engine's overworld_frame() macro
# addresses the wrong tiles, and the first frames come out blank (invisible NPCs).
GFX := tools/gbagfx/gbagfx
OBJ_EVENT_PICS := $(patsubst %.png,%.4bpp,$(wildcard graphics/object_events/pics/*/*.png))

# ---------------------------------------------------------------------------
# Audio assets.
#
# pret's audio_rules.mk cannot be included as-is: it assembles songs with the
# GBA cross-assembler and drives them through the ROM's object list. The data
# itself is still pret's, so the two converters are the only tools needed:
#
#   * wav2agb turns each .wav into the raw `struct WaveData` blob the mixer
#     reads. Cries are DPCM-compressed (`-c`), voices are not, which is exactly
#     what audio_rules.mk's two rules do; the compressed output is padded to a
#     4-byte boundary because the mixer reads samples as signed bytes but the
#     blob is cast to a struct with 4-byte members.
#   * mid2agb turns each .mid into song bytecode, which
#     tools/gen_sound_data.py then compiles into native C (the generated file
#     is tracked, so mid2agb is only needed to regenerate it).
#
# The .aif/.wav -> .bin outputs are gitignored (they are build products, like
# the graphics), so they are generated on demand here.
# ---------------------------------------------------------------------------
WAV2AGB := tools/wav2agb/wav2agb
MID2AGB := tools/mid2agb/mid2agb

SOUND_SAMPLE_WAVS := $(wildcard sound/direct_sound_samples/*.wav)
SOUND_CRY_WAVS := $(wildcard sound/direct_sound_samples/cries/*.wav)
SOUND_SAMPLE_BINS := $(SOUND_SAMPLE_WAVS:.wav=.bin)
SOUND_CRY_BINS := $(SOUND_CRY_WAVS:.wav=.bin)
SOUND_ASSETS := $(SOUND_SAMPLE_BINS) $(SOUND_CRY_BINS)

# Voices: uncompressed, straight conversion.
sound/direct_sound_samples/%.bin: sound/direct_sound_samples/%.wav
	@mkdir -p $(dir $@)
	@$(WAV2AGB) -b $< $@

# Cries: DPCM-compressed, then padded to a 4-byte multiple so the blob's
# WaveData header and sample data stay aligned when cast.
sound/direct_sound_samples/cries/%.bin: sound/direct_sound_samples/cries/%.wav
	@mkdir -p $(dir $@)
	@$(WAV2AGB) -b -c -l 1 --no-pad $< $@
	@sz=$$(wc -c < $@); pad=$$(( (4 - sz % 4) % 4 )); \
	 if [ $$pad -ne 0 ]; then dd if=/dev/zero bs=1 count=$$pad >> $@ 2>/dev/null; fi

# pret's per-asset rules carry the conversion flags that matter (-num_tiles,
# -mwidth/-mheight, and the two-palette `cat` for textbox.gbapal). Without them
# those assets convert with the defaults and either fail or decode wrong.
include graphics_file_rules.mk
include tileset_rules.mk
include spritesheet_rules.mk

# NOTE: graphics_file_rules.mk is pret's file, kept verbatim except for one
# deletion: its rule for graphics/unused/redyellowgreen_frame.bin `cat`s four
# frame .bin files that do not exist in this repository or upstream, while the
# concatenated result IS tracked. An absent prerequisite with no rule is a hard
# make error even though the target exists, and it cannot be neutralised from
# here (rules accumulate prerequisites, and an empty recipe on the inputs makes
# `cat` run and truncate the tracked file). The tracked .bin is a source.

# Battle engine INCBIN targets (terrain, transitions, interface, records) plus
# the battle-animation sprite sheets. Both are generated from checked-in
# PNG/PAL/BIN sources; see the included files for the per-asset rules.
include tools/battle_assets.mk
include tools/anim_sprite_assets.mk
include tools/battle_extra_assets.mk

# --- Generated constants headers -------------------------------------------
# pret's Makefile generates these from JSON and gitignores them (they are build
# products). `Makefile.native` never did, so a fresh clone was missing the
# headers the engine includes -- map_groups.h alone is reachable from every
# file that names a map. Generate them the same way pret does, from the same
# tools and the same inputs, so the output matches the checked-in pret build.
MAPJSON  := tools/mapjson/mapjson
JSONPROC := tools/jsonproc/jsonproc

# gbagfx, preproc, mapjson, jsonproc and wav2agb are build products, not
# sources: all are gitignored, so a fresh clone has none and every asset rule
# dies with "No such file or directory". Build them on demand.
$(GFX) $(PREPROC) $(MAPJSON) $(JSONPROC) $(WAV2AGB) $(MID2AGB):
	@$(MAKE) -C $(dir $@)

MAP_JSONS := $(wildcard data/maps/*/map.json)

GEN_HEADERS := \
	include/constants/map_groups.h \
	include/constants/layouts.h \
	include/constants/map_event_ids.h \
	include/constants/region_map_sections.h \
	include/constants/heal_locations.h \
	src/data/items.h \
	src/data/wild_encounters.h \
	src/data/heal_locations.h \
	src/data/region_map/region_map_entries.h \
	src/data/region_map/region_map_entry_strings.h

# map_groups.json also emits the .inc files the GBA build consumes; only the
# header is needed here, so invoke the generator per header instead of copying
# pret's recipe (which writes several outputs from one rule).
include/constants/map_groups.h: data/maps/map_groups.json | $(MAPJSON)
	@$(MAPJSON) groups firered $< data/maps include/constants

include/constants/layouts.h: data/layouts/layouts.json | $(MAPJSON)
	@$(MAPJSON) layouts firered $< data/layouts include/constants

# Event constants depend on every map.json, so this is the slow one.
include/constants/map_event_ids.h: $(MAP_JSONS) | $(MAPJSON)
	@$(MAPJSON) event_constants firered $(MAP_JSONS) $@

include/constants/region_map_sections.h: src/data/region_map/region_map_sections.json src/data/region_map/region_map_sections.constants.json.txt | $(JSONPROC)
	@$(JSONPROC) $^ $@

include/constants/heal_locations.h: src/data/heal_locations.json src/data/heal_locations.constants.json.txt | $(JSONPROC)
	@$(JSONPROC) $^ $@

src/data/items.h: src/data/items.json src/data/items.json.txt | $(JSONPROC)
	@$(JSONPROC) $^ $@

src/data/wild_encounters.h: src/data/wild_encounters.json src/data/wild_encounters.json.txt | $(JSONPROC)
	@$(JSONPROC) $^ $@

src/data/heal_locations.h: src/data/heal_locations.json src/data/heal_locations.json.txt | $(JSONPROC)
	@$(JSONPROC) $^ $@

src/data/region_map/region_map_entries.h: src/data/region_map/region_map_sections.json src/data/region_map/region_map_sections.entries.json.txt | $(JSONPROC)
	@$(JSONPROC) $^ $@

src/data/region_map/region_map_entry_strings.h: src/data/region_map/region_map_sections.json src/data/region_map/region_map_sections.strings.json.txt | $(JSONPROC)
	@$(JSONPROC) $^ $@

generated-headers: $(GEN_HEADERS)

# The generated assets are prerequisites of `assets`, and make may start them in
# parallel with `tools`, so every asset target names the tool as an order-only
# prerequisite instead of relying on the order of `assets`'s own prerequisites.
# Order-only keeps a rebuilt tool from forcing every asset to regenerate.
$(OBJ_EVENT_PICS) \
$(BATTLE_4BPP_FROM_PNG) $(BATTLE_GBAPAL_FROM_PAL) $(BATTLE_GBAPAL_FROM_PNG) \
$(BATTLE_4BPP_LZ) $(BATTLE_GBAPAL_LZ) $(BATTLE_BIN_LZ) \
$(BATTLE_EXTRA_4BPP_FROM_PNG) $(BATTLE_EXTRA_GBAPAL_FROM_PAL) \
$(BATTLE_EXTRA_GBAPAL_FROM_PNG) $(BATTLE_EXTRA_4BPP_LZ) $(BATTLE_EXTRA_BIN_LZ) \
$(ANIM_SPRITE_4BPP) $(ANIM_SPRITE_TARGETS): | $(GFX)

# Sprites with no entry in spritesheet_rules.mk (mostly single-frame misc/pokemon
# icons) really are row-major; pret relies on this plain rule for them.
# `Makefile.native` originally had only the .4bpp-from-PNG half of pret's
# implicit conversion set, so a clean tree failed on the .pal -> .gbapal, PNG ->
# .gbapal and uncompressed -> .lz steps for assets outside the rule files.
%.4bpp: %.png | $(GFX)
	@$(GFX) $< $@
%.8bpp: %.png | $(GFX)
	@$(GFX) $< $@
%.1bpp: %.png | $(GFX)
	@$(GFX) $< $@
%.gbapal: %.pal | $(GFX)
	@$(GFX) $< $@
%.gbapal: %.png | $(GFX)
	@$(GFX) $< $@
%.lz: % | $(GFX)
	@$(GFX) $< $@

# Every INCBIN the sources reach, derived from the sources themselves so the
# list cannot drift: tools/list_incbin_assets.py scans src/ and returns each
# untracked target it can resolve through the build's own rules. pret's
# dependency on these files is implicit; naming them explicitly is what lets
# object compilation wait for `assets`.
INCBIN_ASSETS := $(shell python3 tools/list_incbin_assets.py)

# Build the conversion tools before any asset recipe can run.
#
# gbagfx, preproc, mapjson and jsonproc are gitignored build products, so a
# fresh clone has none. Each asset target takes the one it needs as an order-only
# prerequisite (below), and the stamp's sub-make ordering covers the pattern-rule
# paths that cannot be enumerated. This target remains as a manual entry point.
.PHONY: tools
tools:
	@$(MAKE) -f $(firstword $(MAKEFILE_LIST)) $(GFX) $(PREPROC) $(MAPJSON) $(JSONPROC) $(WAV2AGB) $(MID2AGB)

# Every concrete asset target named by the rule files, read back out of them so
# the list cannot drift. The tools themselves are excluded: depending on gbagfx
# from gbagfx's own rule is a cycle, which make drops with a warning and then
# schedules the asset recipes before the tool exists.
RULE_FILE_TARGETS := $(shell python3 tools/list_incbin_assets.py --list-targets)

$(INCBIN_ASSETS) $(OBJ_EVENT_PICS) $(RULE_FILE_TARGETS) \
$(BATTLE_4BPP_FROM_PNG) $(BATTLE_GBAPAL_FROM_PAL) $(BATTLE_GBAPAL_FROM_PNG) \
$(BATTLE_4BPP_LZ) $(BATTLE_GBAPAL_LZ) $(BATTLE_BIN_LZ) \
$(BATTLE_EXTRA_4BPP_FROM_PNG) $(BATTLE_EXTRA_GBAPAL_FROM_PAL) \
$(BATTLE_EXTRA_GBAPAL_FROM_PNG) $(BATTLE_EXTRA_4BPP_LZ) $(BATTLE_EXTRA_BIN_LZ) \
$(ANIM_SPRITE_4BPP) $(ANIM_SPRITE_TARGETS): | $(GFX)

