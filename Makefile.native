	@tools/gbagfx/gbagfx graphics/object_events/palettes/npc_blue.pal graphics/object_events/palettes/npc_blue.gbapal

$(OBJ_DIR)/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

# Sources containing charmap text (`_("...")`) or INCBIN assets must be run
# through tools/preproc (fix #2). GNU Make 3.81 (macOS) rejects static pattern
# rules carrying a generated target list, so one rule per source is emitted via
# $(eval). Adding a file to PREPROC_SRCS is then all that is needed.
#
# `$$` is deliberate: the rule text passes through $(call) (one expansion) and
# then $(eval) (parses the result), so a single `$$` survives as `$` in the
# recipe where `$@`/`$<` must expand at build time.
define PREPROC_RULE
$(OBJ_DIR)/$(1).o: src/$(1).c | battle-scripts
	@mkdir -p $$(dir $$@)
	$$(CC) -E $$(CFLAGS) $$< | $$(PREPROC) -i $$< charmap.txt | $$(CC) $$(CFLAGS) -x c -c -o $$@ -
endef

$(foreach src,$(PREPROC_SRCS),$(eval $(call PREPROC_RULE,$(patsubst src/%.c,%,$(src)))))


$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) $^ $(LDFLAGS) -o $@

run: $(TARGET)
	./$(TARGET)

clean:
	rm -rf $(OBJ_DIR) $(TARGET)
