OBJ_DIR := build/native
OBJS := $(patsubst src/%.c,$(OBJ_DIR)/%.o,$(PLATFORM_SRCS) $(ENGINE_SRCS) $(PREPROC_SRCS))

TARGET := firered-native

# `all` does not name the phony `assets` target. Naming a target with thousands
# of prerequisites makes make re-walk that subgraph from every dependent, which
# is the pathology the stamp below exists to avoid; the objects get their
# ordering edge from the stamp, and `assets` stays a manual entry point.
all: $(TARGET)

.PHONY: all clean run assets battle-scripts tools generated-headers tests clean-tests test-list script-ops

# Battle script bytecode + the shared native pointer table. Regenerate whenever
# the pret script sources, their macros, or the C readers they are classified
# against change (the classification is derived from those readers).
BATTLE_SCRIPT_SOURCES := $(wildcard data/battle_scripts_*.s data/battle_anim_scripts.s data/battle_ai_scripts.s) \
                         $(wildcard asm/macros/battle_script.inc asm/macros/battle_anim_script.inc asm/macros/battle_ai_script.inc) \
                         src/battle_script_commands.c src/battle_anim.c src/battle_ai_script_commands.c \
                         tools/gen_battle_data.py

# The generator takes ~10 s (it derives every script's operand widths from the C
# readers), so it must not run when nothing it reads has changed. It used to be
# `.PHONY`, which made EVERY `make` -- including a no-op one -- regenerate the
# battle scripts and recompile everything downstream: measured 10.64 s for a
# build with nothing to do, versus 0.31 s with the generator skipped. That is
# the same trap fix #54 records for the split anim sheets. The phony name stays
# as the documented regenerate entry point; the real work hangs off a stamp.
BATTLE_SCRIPTS_STAMP := $(OBJ_DIR)/.battle-scripts.stamp

battle-scripts: $(BATTLE_SCRIPTS_STAMP)

$(BATTLE_SCRIPTS_STAMP): $(BATTLE_SCRIPT_SOURCES)
	@python3 tools/gen_battle_data.py
	@mkdir -p $(dir $@)
	@touch $@

# The ordering edge the objects need, and the fix for a make pathology worth
# understanding before touching this file.
#
# The asset graph has several thousand nodes (the derived INCBIN list alone is
# ~6400 paths). Naming that list as a prerequisite of any target the top-level
# make walks makes GNU Make 3.81 recurse inside its own dependency walk under
# `-j` instead of starting children: no child process appears, CPU sits at 100%,
# and the build never finishes. Measured on this Makefile, a derived-list
# prerequisite of 1179 entries is enough to trigger it; either phase alone
# (derived list, or the aggregates) completes in under a second.
#
# So the large list is never a prerequisite in the top-level graph. The objects
# depend on this one real-file stamp, and the stamp's recipe drives both asset
# phases through sub-makes. `-j1` is required there: the sub-make inherits
# MAKEFLAGS, so a parallel sub-make reproduces the same spin internally.
ASSET_STAMP := $(OBJ_DIR)/.assets.stamp

$(ASSET_STAMP): $(GEN_HEADERS) | $(GFX) $(PREPROC) $(WAV2AGB)
	@$(MAKE) -s -j1 -f $(firstword $(MAKEFILE_LIST)) derived-assets
	@$(MAKE) -s -j1 -f $(firstword $(MAKEFILE_LIST)) assets
	@mkdir -p $(dir $@)
	@touch $@

# The rule-driven half of the asset set: every INCBIN the sources reach that the
# aggregates do not already list. Only ever built through the stamp above.
.PHONY: derived-assets
derived-assets: $(INCBIN_ASSETS) $(SOUND_ASSETS)
	@:

# `make assets` generates the rest. This is the documented "generate the assets
# and stop" entry point and the target the stamp's sub-make runs.
assets: $(GFX) $(PREPROC) $(GEN_HEADERS) $(OBJ_EVENT_PICS) battle-assets anim-sprite-assets battle-extra-assets
	@mkdir -p $(OBJ_DIR)/platform
	@tools/gbagfx/gbagfx graphics/title_screen/border_bg.png graphics/title_screen/border_bg.4bpp
	@tools/gbagfx/gbagfx graphics/title_screen/border_bg.4bpp graphics/title_screen/border_bg.4bpp.lz
	@tools/gbagfx/gbagfx graphics/title_screen/firered/border_bg.bin graphics/title_screen/firered/border_bg.bin.lz
	@tools/gbagfx/gbagfx graphics/title_screen/slash.png graphics/title_screen/slash.4bpp
	@tools/gbagfx/gbagfx graphics/title_screen/slash.4bpp graphics/title_screen/slash.4bpp.lz
	@tools/gbagfx/gbagfx graphics/title_screen/firered/slash.pal graphics/title_screen/firered/slash.gbapal
	@tools/gbagfx/gbagfx graphics/title_screen/firered/flames.png graphics/title_screen/firered/flames.gbapal
	@tools/gbagfx/gbagfx graphics/title_screen/firered/flames.png graphics/title_screen/firered/flames.4bpp
	@tools/gbagfx/gbagfx graphics/title_screen/firered/flames.4bpp graphics/title_screen/firered/flames.4bpp.lz
	@tools/gbagfx/gbagfx graphics/title_screen/firered/blank_flames.png graphics/title_screen/firered/blank_flames.4bpp
	@tools/gbagfx/gbagfx graphics/title_screen/firered/blank_flames.4bpp graphics/title_screen/firered/blank_flames.4bpp.lz
	@tools/gbagfx/gbagfx graphics/title_screen/blank_sprite.png graphics/title_screen/blank_sprite.4bpp
	@tools/gbagfx/gbagfx graphics/title_screen/blank_sprite.4bpp graphics/title_screen/blank_sprite.4bpp.lz
	@for i in 1 2 3 4 5 6; do tools/gbagfx/gbagfx graphics/title_screen/unused$$i.bin graphics/title_screen/unused$$i.bin.lz; done
	@tools/gbagfx/gbagfx graphics/title_screen/firered/game_title_logo.pal graphics/title_screen/firered/game_title_logo.gbapal
	@tools/gbagfx/gbagfx graphics/title_screen/firered/game_title_logo.png graphics/title_screen/firered/game_title_logo.8bpp
