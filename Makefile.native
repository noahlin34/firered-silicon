CC := clang
PREPROC := tools/preproc/preproc

# Including spritesheet_rules.mk below defines concrete targets; keep `all` as
# the default goal rather than the first rule from that file.
.DEFAULT_GOAL := all

# Top-left FPS overlay in the SDL2 window (src/platform/sdl2.c). Release builds:
#   rm -f build/native/platform/sdl2.o && make -f Makefile.native FPS_OVERLAY=0
# Objects do not depend on CFLAGS, so the stale sdl2.o must be removed first.
FPS_OVERLAY ?= 1

CFLAGS := -Wall -Wextra -std=c11 -O2 -DPORTABLE -DMODERN=1 -DFIRERED -DENGLISH -DREVISION=0 -Iinclude -Isrc \
          $(shell /opt/homebrew/bin/sdl2-config --cflags) \
          -Wno-ignored-qualifiers -Wno-unused-parameter -Wno-unused-function -Wno-unused-variable \
          -Wno-sign-compare -Wno-unknown-escape-sequence \
          $(if $(filter 1,$(FPS_OVERLAY)),-DFPS_OVERLAY,)
LDFLAGS := $(shell /opt/homebrew/bin/sdl2-config --libs)

# Canonical overworld spritesheet rules. pret's spritesheet_rules.mk gives every
# object event sprite the -mwidth/-mheight flags its PNG layout needs; without
# them gbagfx emits plain row-major tiles, the engine's overworld_frame() macro
# addresses the wrong tiles, and the first frames come out blank (invisible NPCs).
GFX := tools/gbagfx/gbagfx
include spritesheet_rules.mk

# Battle engine INCBIN targets (terrain, transitions, interface, records) plus
# the battle-animation sprite sheets. Both are generated from checked-in
# PNG/PAL/BIN sources; see the included files for the per-asset rules.
include tools/battle_assets.mk
include tools/anim_sprite_assets.mk
include tools/battle_extra_assets.mk

OBJ_EVENT_PICS := $(patsubst %.png,%.4bpp,$(wildcard graphics/object_events/pics/*/*.png))

# Sprites with no entry in spritesheet_rules.mk (mostly single-frame misc/pokemon
# icons) really are row-major; pret relies on this plain rule for them.
%.4bpp: %.png
	@$(GFX) $< $@

